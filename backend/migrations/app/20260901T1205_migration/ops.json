        "params": [
          "\"public\".\"exercise\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"exercise\"",
        "sql": "CREATE TABLE \"public\".\"exercise\" (\n  \"equipment\" text,\n  \"id\" SERIAL NOT NULL,\n  \"muscleGroup\" text,\n  \"name\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"exercise\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"exercise\""
        ]
      }
    ]
  },
  {
    "id": "column.public.user.password",
    "label": "Add column \"password\" to \"user\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "password",
        "table": "user"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"password\" is missing",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "user",
          "password"
        ]
      }
    ],
    "execute": [
      {
        "description": "add column \"password\"",
        "sql": "ALTER TABLE \"public\".\"user\" ADD COLUMN \"password\" text"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"password\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "user",
          "password"
        ]
      }
    ]
  }
